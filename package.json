{
  "name": "honeycomb",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/build-serwist.ts --development && (bun --watch scripts/build-serwist.ts --development &) && bun next dev",
    "build": "bun next build && bun scripts/build-serwist.ts --production",
    "start": "bun next start",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "analyze": "bun next experimental-analyze --output",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,scss}\"",
    "check-types": "bun next typegen && bun tsc --noEmit",
    "quality:spec": "openspec validate --all --strict && bun scripts/check-diff.ts",
    "prepare": "husky",
    "test": "vitest",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:process": "vitest run --config vitest.process.config.mts",
    "test:e2e": "bun --no-env-file scripts/e2e-preflight.ts",
    "test:e2e:development": "bun --no-env-file scripts/e2e-preflight.ts --project=chromium --grep-invert @production",
    "test:e2e:production": "bun --no-env-file scripts/e2e-preflight.ts --project=chromium --grep @production",
    "test:e2e:ui": "bun --no-env-file scripts/e2e-preflight.ts --ui",
    "test:e2e:smoke": "bun --no-env-file scripts/e2e-preflight.ts --grep @smoke",
    "test:e2e:regression": "bun --no-env-file scripts/e2e-preflight.ts --grep @regression",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun scripts/migrate-database.ts",
    "db:invariants:audit": "bun scripts/audit-persistence-invariants.ts",
    "db:e2e:seed": "bun scripts/seed-e2e.ts",
    "db:schema:audit": "bun scripts/audit-production-schema.ts",
    "db:migrations:check": "bun scripts/check-migrations.ts",
    "audit:production": "bun scripts/audit-production-dependencies.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@daypicker/react": "^10.0.2",
    "@hookform/resolvers": "^6.0.0",
    "@libsql/client": "^0.18.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@next/third-parties": "16.4.2",
    "@nosferatu500/react-dnd": "^19.2.0",
    "@nosferatu500/react-dnd-html5-backend": "^19.2.0",
    "@nosferatu500/react-sortable-tree": "7.1.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "11.8.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "html-react-parser": "^6.1.9",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.61.0",
    "md5": "^2.3.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "photoswipe": "^5.4.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-toggle-dark-mode": "2.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@serwist/build": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "postcss": "8.5.31",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "semver": "^7.8.5",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "bun@1.4.3",
  "repository": "https://github.com/guanweisong/honeycomb.git",
  "author": "guanweisong <307761682@qq.com>",
  "license": "MIT",
