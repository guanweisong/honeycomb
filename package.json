{
  "name": "honeycomb",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun next dev",
    "build": "bun next build",
    "start": "bun next start",
    "lint": "bunx eslint -c eslint-config-next.ts .",
    "lint:fix": "bunx eslint -c eslint-config-next.ts . --fix",
    "analyze": "bun next experimental-analyze --output",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,scss}\"",
    "check-types": "bun tsc --noEmit",
    "quality:spec": "openspec validate --all --strict && bun scripts/check-diff.ts",
    "prepare": "husky",
    "test": "vitest",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:process": "vitest run --config vitest.process.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:development": "playwright test --project=chromium --grep-invert @production",
    "test:e2e:production": "playwright test --project=chromium --grep @production",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:regression": "playwright test --grep @regression",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun scripts/migrate-database.ts",
    "db:invariants:audit": "bun scripts/audit-persistence-invariants.ts",
    "db:e2e:seed": "bun scripts/seed-e2e.ts",
    "db:schema:audit": "bun scripts/audit-production-schema.ts --output docs/production-schema-baseline-report.md",
    "db:migrations:check": "bun scripts/check-migrations.ts",
    "audit:production": "bun scripts/audit-production-dependencies.ts"
  },
  "dependencies": {
